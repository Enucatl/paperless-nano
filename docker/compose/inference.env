# Replace endpoints/model identities before admitting documents.
PAPERLESS_SECRET_KEY=replace-with-a-random-secret
INFERENCE_OCR_ENDPOINT=http://your-ocr-server:8080
INFERENCE_OCR_PIPELINE=PaddleOCR-VL-1.6
INFERENCE_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
INFERENCE_OCR_LAYOUT_MODEL=PP-DocLayoutV3
INFERENCE_OCR_TIMEOUT=600
INFERENCE_METADATA_ENDPOINT=http://your-metadata-server:8080/v1
INFERENCE_METADATA_MODEL=your-immutable-model-revision
# Set OPENAI_API_KEY here if the inference endpoint requires authentication.
# Provision the managed custom fields, then replace this empty mapping before uploads.
PAPERLESS_ENRICHMENT_FIELDS={}
# PAPERLESS_OCR_PROVENANCE_FIELD=<ai_ocr_output field ID>
