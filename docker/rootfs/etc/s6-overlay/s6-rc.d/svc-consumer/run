#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

if [[ -n "${PAPERLESS_CONSUMER_DISABLE}" ]]; then
	echo "[svc-consumer] Consumer is disabled, exiting"
	s6-svc -Od .
	exit 0
fi

cd "${PAPERLESS_SRC_DIR}"

# init-system-checks validates Django before these services start.
if [[ -n "${USER_IS_NON_ROOT}" ]]; then
	exec python3 -m paperless_services.launcher consumer
else
	exec s6-setuidgid paperless python3 -m paperless_services.launcher consumer
fi
