#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

if [[ -z "${PAPERLESS_PROCESSOR_USER}" && -z "${PAPERLESS_PROCESSOR_CAPABILITIES}" ]]; then
	echo "Server processor disabled; queued provider work requires an eligible external processor or explicit server configuration."
	exec s6-svc -Od .
fi

cd "${PAPERLESS_SRC_DIR}" || exit 1
if [[ -n "${USER_IS_NON_ROOT}" ]]; then
	exec python3 -m paperless_services.launcher processor
else
	exec s6-setuidgid paperless python3 -m paperless_services.launcher processor
fi
